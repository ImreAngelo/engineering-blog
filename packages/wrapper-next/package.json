{
  "name": "@engineering-blog/next",
  "version": "0.0.0",
  "description": "Next.js server components for rendering the blog template's Portable Text",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.tsx"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "next": ">=15",
    "next-sanity": ">=12",
    "react": "^19"
  },
  "dependencies": {
    "@engineering-blog/queries": "workspace:*",
    "katex": "^0.16.33",
    "server-only": "^0.0.1",
    "shiki": "^3.22.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/react": "^19",
    "next": "16.3.8",
    "next-sanity": "^13.3.4",
    "react": "19.2.8",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  }
}
