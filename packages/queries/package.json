{
  "name": "@engineering-blog/queries",
  "version": "0.0.0",
  "description": "GROQ queries and generated TypeScript types for the blog template",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./types": {
        "types": "./dist/types.d.mts",
        "default": "./dist/types.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typegen": "sanity typegen generate"
  },
  "dependencies": {
    "groq": "^6.17.0"
  },
  "devDependencies": {
    "@engineering-blog/studio": "workspace:*",
    "sanity": "^6.17.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  }
}
