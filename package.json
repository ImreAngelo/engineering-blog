{
  "name": "blog",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm run /^dev:/",
    "dev:studio": "pnpm env:sync && pnpm --filter sanity-studio dev --port=3000",
    "dev:next16": "pnpm env:sync && pnpm --filter next-16 dev --port=8080",
    "env:sync": "node scripts/sync-env.mjs",
    "postinstall": "node scripts/sync-env.mjs || true",
    "typegen": "pnpm --filter @engineering-blog/studio schema:extract && pnpm --filter @engineering-blog/queries typegen",
    "build": "pnpm typegen && pnpm --filter \"./packages/*\" build",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
